# Python environment and caches
venv/
__pycache__/
*.pyc

# Secrets
.env

# Data files (shared via Drive, not Git) - keep the folder structure via .gitkeep
data/raw/modis/*
data/raw/viirs/*
data/processed/*
!data/raw/modis/.gitkeep
!data/raw/viirs/.gitkeep
!data/processed/.gitkeep
# Backend Python virtual environments
.venv/
backend/.venv/
backend/venv/

# Backend logs
backend/logs/*
!backend/logs/.gitkeep
# ModVSync backend datasets - keep raw data outside Git
/backend/data/raw/*
!/backend/data/raw/**/
!/backend/data/raw/**/.gitkeep

# Generated and processed backend data
/backend/data/processed/*
!/backend/data/processed/.gitkeep

# Generated analysis reports
/backend/data/reports/*
!/backend/data/reports/.gitkeep

# Backend logs
/backend/logs/*
!/backend/logs/.gitkeep
# Ignore all raw backend data, but preserve directory structure
/backend/data/raw/**
!/backend/data/raw/**/
!/backend/data/raw/**/.gitkeep
backend/data/
